# Copia este archivo como .env y completa los valores. .env nunca se sube a GitHub.

# Puerto del servidor
PORT=3000

# --- Acceso al CRM (/admin) ---
# Primer administrador: se crea solo la primera vez, cuando todavía no hay usuarios.
# Después, los usuarios se gestionan desde la pestaña "Usuarios" del CRM.
ADMIN_EMAIL=
ADMIN_NOMBRE=
# Mínimo 10 caracteres
ADMIN_PASSWORD=
# Texto aleatorio largo para firmar la sesión. Si falta, las sesiones se cierran al reiniciar.
SESSION_SECRET=

# --- Google Sheets ---
# Si faltan estos dos valores, en desarrollo los contactos se guardan en data/crm.json
# ID de la hoja: la parte entre /d/ y /edit en la URL de Google Sheets
GOOGLE_SHEET_ID=
# Ruta al archivo JSON de la cuenta de servicio de Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=./credenciales/google-service-account.json

# --- Aviso por correo de nuevos contactos (opcional) ---
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una contraseña de aplicación
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Correo que recibe los avisos
NOTIFY_EMAIL=
# URL pública del sitio, para el enlace del correo (ej. https://midominio.com)
PUBLIC_URL=
