# Copia este archivo como .env y completa los valores. .env nunca se sube a GitHub.

# Puerto del servidor
PORT=3000
# "production" en el servidor real (Render, Railway, VPS): cookie segura, HTTPS obligatorio,
# Google Sheets obligatorio y SESSION_SECRET obligatoria. En tu computador déjalo vacío.
NODE_ENV=

# --- Sitio privado ---
# "si": solo entra quien tenga cuenta en el CRM (todo el sitio pide iniciar sesión y
# los buscadores no lo indexan). Cualquier otro valor abre el sitio al público.
# En producción, el sitio no arranca abierto si config/corporacion.json tiene campos
# "por definir" (Ley 1581 de 2012).
# Para publicarlo, cambia a "no" y reinicia el servidor.
SITIO_PRIVADO=si

# Proxies de confianza delante del servidor. Vacío = 1 en producción, ninguno en desarrollo.
# Acepta un número (1), true/false o un texto (ej. loopback). Nginx o la plataforma: 1.
# Cuidado: TRUST_PROXY=false detrás de un proxy hace que el servidor nunca vea HTTPS
# y entre en un bucle de redirecciones (ver FORZAR_HTTPS).
TRUST_PROXY=

# Redirección a HTTPS (308). Por defecto "si" en producción; "no" la desactiva, necesario si el
# proxy ya fuerza HTTPS o no envía X-Forwarded-Proto. Usa el host de PUBLIC_URL si está definida.
FORZAR_HTTPS=

# --- Acceso al CRM (/admin) ---
# Primer administrador: se crea solo la primera vez, cuando todavía no hay usuarios.
# Después, los usuarios se gestionan desde la pestaña "Usuarios" del CRM.
ADMIN_EMAIL=
ADMIN_NOMBRE=
# Mínimo 10 caracteres. Bórrala de .env (o de las variables del hosting) tras el primer arranque.
ADMIN_PASSWORD=
# Texto aleatorio para firmar la sesión. En producción es OBLIGATORIA y de 32 caracteres o más
# (si no, el servidor no arranca). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# En desarrollo, si falta, las sesiones se cierran al reiniciar.
SESSION_SECRET=

# --- Asignación de contactos ---
# "si": un contacto nuevo se asigna solo al único consultor activo que atiende ese servicio.
# Cualquier otro valor: llegan sin asignar y el administrador los asigna a mano.
ASIGNACION_AUTOMATICA=no

# --- Google Sheets ---
# Si faltan estos dos valores, en desarrollo los contactos se guardan en data/crm.json
# ID de la hoja: la parte entre /d/ y /edit en la URL de Google Sheets
GOOGLE_SHEET_ID=
# Ruta al archivo JSON de la cuenta de servicio de Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=./credenciales/google-service-account.json
# Alternativa para hostings sin archivos (Render, Railway): el contenido completo del JSON,
# tal cual o codificado en base64. Si existe, tiene prioridad sobre la ruta anterior.
GOOGLE_CREDENTIALS_JSON=

# --- Aviso por correo de nuevos contactos (opcional) ---
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una contraseña de aplicación
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Correo(s) que reciben los avisos; varios se separan con comas (ej. a@x.com,b@y.com)
NOTIFY_EMAIL=
# URL pública del sitio, para el enlace del correo (ej. https://midominio.com)
PUBLIC_URL=
